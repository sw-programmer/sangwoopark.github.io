---
layout: default
---
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">
          {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
        </span>
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <style>
    table tr:hover {
      background-color: transparent !important;
      box-shadow: none !important;
      transform: none !important; /* 혹시 모를 움직임 효과 제거 */
    }
    footer {
      display: none !important;
    }
  </style>

  <article>
    <div class="about-intro">
      {% if page.profile %}
        <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.28}}px, (min-width: 576px) 28vw, 265px{% endcapture %}
            {% if page.profile.image_back %}
              {% assign profile_back_path = page.profile.image_back | prepend: 'assets/img/' %}
              <button class="portrait-slideshow" type="button" aria-label="Show alternate portrait" data-portrait-slideshow>
                <img src="{{ profile_image_path | relative_url | bust_file_cache }}" alt="Portrait of Sangwoo Park" width="1538" height="1951" loading="eager">
                <img src="{{ profile_back_path | relative_url | bust_file_cache }}" alt="Alternate portrait of Sangwoo Park" width="1836" height="2654" loading="eager" hidden>
              </button>
            {% else %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
            {% endif %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div class="clearfix">{{ content }}</div>
    </div>

    {% if site.data.news %}
      <h2 id="news" class="mt-4">Updates</h2>
      <ul class="news-list pl-3">
        {% for item in site.data.news %}
          <li class="mb-2">{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if site.data.education %}
      <h2 class="mt-4">Education</h2>
      <div class="table-responsive">
        <table class="table table-sm table-borderless">
          {% for item in site.data.education %}
          <tr>
            <th scope="row" style="width: 20%; font-weight: normal; color: var(--global-text-color-light);">{{ item.year }}</th>
            <td>
              <span class="font-weight-bold">{{ item.course }}</span>
              <br>
              {{ item.institution }}
              {% if item.description %}
                <br><span style="font-size: 0.9em; font-style: italic;">{{ item.description }}</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </table>
      </div>
    {% endif %}

    {% if site.data.work_experience %}
      <h2 class="mt-4">Work Experience</h2>
      <div class="table-responsive">
        <table class="table table-sm table-borderless work-experience">
          {% for item in site.data.work_experience %}
          <tr>
            <th scope="row" style="width: 20%; font-weight: normal; color: var(--global-text-color-light);">{{ item.year }}</th>
            <td class="work-experience-logo">
              {% if item.logo %}
                <img src="{{ item.logo | relative_url }}" alt="" width="48" height="48" loading="lazy">
              {% endif %}
            </td>
            <td>
              <span class="font-weight-bold">{{ item.role }}</span>
              <br>
              {% if item.url %}<a href="{{ item.url }}">{{ item.company }}</a>{% else %}{{ item.company }}{% endif %}{% if item.location %}, {{ item.location }}{% endif %}
              {% if item.description %}
                <br><span style="font-size: 0.9em; color: var(--global-text-color-light);">{{ item.description }}</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </table>
      </div>
    {% endif %}

    <!-- Publications -->
    {% if page.publications %}
      <h2 id="publications" class="mt-4">Publications</h2>
      <p class="small">*: equal contribution</p>
      <div class="publications">
        <h3 class="mt-3">Conference Publications</h3>
        {% bibliography --query @inproceedings[workshop!=true] --group_by none %}
        <h3 class="mt-4">Journal Publications</h3>
        {% bibliography --query @article --group_by none %}
        <h3 class="mt-4">Workshop Publications</h3>
        {% bibliography --query @inproceedings[workshop=true] --group_by none %}
        <h3 class="mt-4">Preprints</h3>
        {% bibliography --query @unpublished --group_by none %}
      </div>
    {% endif %}

    {% if site.data.languages %}
      <h2 id="languages" class="mt-5">Language</h2>
      <div class="table-responsive">
        <table class="table table-sm table-borderless">
          {% for item in site.data.languages %}
          <tr>
            <th scope="row" style="width: 20%;">{{ item.language }}</th>
            <td>{{ item.level }}</td>
          </tr>
          {% endfor %}
        </table>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
