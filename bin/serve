#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Prefer the supported Homebrew Ruby over macOS's bundled Ruby.
if [[ -d /opt/homebrew/opt/ruby@3.3/bin ]]; then
  export PATH="/opt/homebrew/opt/ruby@3.3/bin:/opt/homebrew/bin:$PATH"
fi
if [[ -d .venv/bin ]]; then
  export PATH="$PWD/.venv/bin:$PATH"
fi
export BUNDLE_PATH="${BUNDLE_PATH:-vendor/bundle}"

exec bundle exec jekyll serve --host 127.0.0.1 --port 8080 --livereload "$@"
